# Copy this file to .env in the repository root, or to backend/.env.
# The API reads either file. Do not commit a real .env.
#
# This simulator is a classroom model. These values are not production secrets,
# but treat the JWT secret and card keys as private to your machine anyway.

PORT=5000

# Signs the short-lived terminal pass. Use a long random string.
# If you leave it unset, the API generates one at startup and sessions
# stop working after a restart (the balances reset then too).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How many API calls one address may make in the window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Tap cryptogram: hmac-sha256 (default) or aes-cmac.
# ML-KEM-768 and ML-DSA-65 are slots only. The API will refuse to start
# if you select them.
MAC_SUITE=hmac-sha256

# bcrypt cost for classroom PINs. 8 is a reasonable local default.
BCRYPT_ROUNDS=8

# Classroom PINs. The API hashes these at startup and does not keep the
# plain text on the card. They are printed here so you can try the PIN step.
# ZamPay Kwacha, Liberty Dollar, Alpine Franc.
PIN_CARD001=2580
PIN_CARD002=1492
PIN_CARD003=7731

# Optional stable card keys, 64 hex characters (32 bytes) each.
# Leave them commented to generate a new random key every time the API starts.
# The React app never receives these.
# CARD_KEY_CARD001=
# CARD_KEY_CARD002=
# CARD_KEY_CARD003=

# Frontend only. Put this line in frontend/.env if the API is not on port 5000.
# It is not a secret.
# REACT_APP_API_URL=http://localhost:5000
